# Production Environment Configuration
# Copy this file to .env and update with your production values

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-production-secret-key-minimum-32-characters-long
JWT_SECRET_KEY=your-production-jwt-secret-key-minimum-32-characters-long

# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL=postgresql://username:password@localhost:5432/cybersecurity_toolkit
# Alternative: MySQL
# DATABASE_URL=mysql://username:password@localhost:3306/cybersecurity_toolkit

# SSL/TLS Configuration
SSL_DISABLE=false
SSL_CERT_PATH=/path/to/your/certificate.crt
SSL_KEY_PATH=/path/to/your/private.key

# CORS Configuration (specify allowed origins)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Settings
SESSION_COOKIE_SECURE=true

# Scanning Configuration
MAX_CONCURRENT_SCANS=10
SCAN_TIMEOUT=600
SCAN_RESULTS_FOLDER=/var/lib/cybersecurity-toolkit/scan_results
UPLOAD_FOLDER=/var/lib/cybersecurity-toolkit/uploads

# File Upload Configuration (16MB)
MAX_CONTENT_LENGTH=16777216

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/var/backups/cybersecurity-toolkit

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/cybersecurity-toolkit/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_ENDPOINT_ENABLED=false

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (for notifications)
MAIL_SERVER=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com